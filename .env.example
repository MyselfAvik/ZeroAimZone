# =====================================================================
# GODOT PLUGINS & INTEGRATIONS PACK - CONFIGURATION TEMPLATE
# Copy this file to '.env' in your Godot project root and fill in your keys.
# =====================================================================

# --- 1. FIREBASE (REST API, Auth & Push Notifications) ---
# Note: Native Android & iOS push/analytics auto-read google-services.json & GoogleService-Info.plist.
FIREBASE_API_KEY=your_firebase_api_key
FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_APP_ID=1:1234567890:web:abcdef123456
FIREBASE_WEB_CLIENT_ID=your_oauth_web_client_id.apps.googleusercontent.com
PLAY_GAMES_WEB_CLIENT_ID=your_play_games_web_client_id.apps.googleusercontent.com
APPLE_WEB_CLIENT_ID=your_apple_web_client_id
FIREBASE_STORAGE_BUCKET=your_project.appspot.com
FIREBASE_MESSAGING_SENDER_ID=1234567890
FIREBASE_DATABASE_URL=https://your_project-default-rtdb.firebaseio.com
FIREBASE_FCM_DEFAULT_TOPIC=global

# --- 2. ADMOB ADS (Android & iOS Production Ad Unit IDs) ---
# (Debug builds automatically fallback to Google test IDs if left default)
ADMOB_ANDROID_BANNER_ID=ca-app-pub-3940256099942544/6300978111
ADMOB_ANDROID_INTERSTITIAL_ID=ca-app-pub-3940256099942544/1033173712
ADMOB_ANDROID_REWARDED_ID=ca-app-pub-3940256099942544/5224354917
ADMOB_ANDROID_REWARDED_INTERSTITIAL_ID=ca-app-pub-3940256099942544/5354046379

ADMOB_IOS_BANNER_ID=ca-app-pub-3940256099942544/2934735716
ADMOB_IOS_INTERSTITIAL_ID=ca-app-pub-3940256099942544/4411468910
ADMOB_IOS_REWARDED_ID=ca-app-pub-3940256099942544/1712485313
ADMOB_IOS_REWARDED_INTERSTITIAL_ID=ca-app-pub-3940256099942544/6978759866

# --- 3. META (FACEBOOK) ANALYTICS ---
META_APP_ID=YOUR_META_APP_ID
META_CLIENT_TOKEN=YOUR_META_CLIENT_TOKEN

# --- 4. IN-APP PURCHASES (IAP) ---
# Comma-separated list of consumable product IDs (buyable multiple times)
IAP_CONSUMABLE_PRODUCT_IDS=coin_pack_small,coin_pack_large,gem_pack

# --- 5. GAMEANALYTICS ---
GAMEANALYTICS_GAME_KEY_ANDROID=
GAMEANALYTICS_SECRET_KEY_ANDROID=
GAMEANALYTICS_GAME_KEY_IOS=
GAMEANALYTICS_SECRET_KEY_IOS=

# --- 6. GOOGLE PLAY GAME SERVICES (Android) ---
PLAY_SERVICES_APP_ID=123456789012

# --- 7. APPLE GAME CENTER (iOS) ---
GAME_CENTER_LEADERBOARD_ID=com.yourcompany.game.highscore
