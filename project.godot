; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[admob]

general/android/app_id="ca-app-pub-8530302013109448~2325377678"
general/ios/app_id="ca-app-pub-8530302013109448~6083070530"

[application]

config/name="Zero Aim Zone"
config/version="0.0.21"
run/main_scene="uid://bp2epqcxsqgvw"
config/disable_project_settings_override=true
config/quit_on_go_back=false
config/features=PackedStringArray("4.6", "Mobile")
run/max_fps=200
boot_splash/bg_color=Color(0, 0, 0, 1)
boot_splash/image="uid://ddoqtprdaxjr2"
config/icon="uid://m6jsdqxigg16"

[autoload]

Env="*res://Autoloads/Env.gd"
